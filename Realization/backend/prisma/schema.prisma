generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  parentId         Int?
  nameEn           String?
  nameRu           String?
  nameBe           String?
  nameDe           String?
  nameEs           String?
  namePt           String?
  nameUk           String?
  nameZh           String?
  parent           Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         Category[]       @relation("CategoryHierarchy")
  Course           Course[]
  courseCategories CourseCategory[]
}

model Course {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  description       String?
  category          Int?
  status            String             @default("draft")
  language          String?
  learningFormat    String?
  learningOutcomes  String?
  level             String?
  requirements      String?
  shortDescription  String?
  workload          String?
  introUrl          String?
  logoUrl           String?
  acquiredAssets    String?
  targeting         String?
  ownerId           Int?               // ID пользователя-владельца курса
  Category          Category?          @relation(fields: [category], references: [id], onDelete: Cascade)
  owner             User?              @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  courseCategories  CourseCategory[]
  comments          CourseComment[]
  ratings           CourseRating[]
  enrollments       Enrollment[]
  favorites         FavoriteCourse[]
  lectures          Lecture[]
  notifications     Notification[]
  testAttempts      TestAttempt[]
}

model CourseCategory {
  id         Int      @id @default(autoincrement())
  courseId   Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, categoryId])
}

model Enrollment {
  id        Int     @id @default(autoincrement())
  user_id   Int?
  course_id Int?
  approved  Boolean @default(false)
  progress  Int     @default(0)
  Course    Course? @relation(fields: [course_id], references: [id], onDelete: Cascade)
  User      User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model FavoriteCourse {
  id        Int    @id @default(autoincrement())
  user_id   Int
  course_id Int
  Course    Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  User      User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model Lecture {
  id                Int                @id @default(autoincrement())
  name              String
  videoLink         String?
  content           String?
  course_id         Int?
  moduleId          BigInt?
  order             Int?               @default(1)
  isPinned          Boolean            @default(false)
  Course            Course?            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  steps             Step[]
}

model Step {
  id          Int     @id @default(autoincrement())
  lesson_id   Int
  type        String
  title       String?
  content     String?
  description String?
  videoUrl    String?
  fileUrl     String?
  filename    String?
  order       Int
  Lesson      Lecture @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
}

model User {
  id                       Int                @id @default(autoincrement())
  email                    String             @unique
  password                 String
  role                     Roles              @default(USER)
  username                 String             @unique
  createdAt                DateTime           @default(now())
  emailVerificationExpires DateTime?
  emailVerificationToken   String?            @unique
  isVerified               Boolean            @default(false)
  updatedAt                DateTime           @updatedAt
  avatar                   String?
  lastDevice               String?
  lastOS                   String?
  lastIP                   String?
  lastCountry              String?
  lastBrowser              String?
  lastActivityTime         DateTime?
  dribbbleId               String?            @unique
  facebookId               String?            @unique
  googleId                 String?            @unique
  yandexId                 String?            @unique
  commentReactions         CommentReaction[]
  comments                 CourseComment[]
  ratings                  CourseRating[]
  Enrollment               Enrollment[]
  favorites                FavoriteCourse[]
  messages                 Message[]
  notifications            Notification[]
  Profile                  Profile?
  reactions                Reaction[]
  supportMessages          SupportMessage[]
  testAttempts             TestAttempt[]
  ownedCourses             Course[]        @relation("CourseOwner")
}

model Profile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  skills         String[]
  bio            String?
  githubusername String?
  date           DateTime @default(now())
  city           String?
  company        String?
  country        String?
  position       String?
  status         String?
  aboutMe        String?
  additionalName String?
  goal           String?
  jobTitle       String?
  name           String?
  surname        String?
  avatar         String?
  language       String?
  user           User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  courseId  Int?
  createdAt DateTime @default(now())
  message   String   @default("Новое уведомление")
  read      Boolean  @default(false)
  title     String   @default("Уведомление")
  type      String   @default("info")
  userId    Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  message   String
  status    String
  error     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Chat {
  id        String    @id
  name      String
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        Int        @id @default(autoincrement())
  chatId    String
  userId    Int?
  text      String
  sentAt    DateTime   @default(now())
  caption   String?
  fileType  String?
  fileUrl   String?
  preview   String?
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
}

model Reaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model CourseRating {
  id        Int      @id @default(autoincrement())
  courseId  Int
  userId    Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model CourseComment {
  id        Int               @id @default(autoincrement())
  courseId  Int
  userId    Int
  content   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isEdited  Boolean           @default(false)
  reactions CommentReaction[]
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommentReaction {
  id        Int           @id @default(autoincrement())
  commentId Int
  userId    Int
  type      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  comment   CourseComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId], name: "commentId_userId")
}

model TestAttempt {
  id          Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int
  lesson_id   Int
  step_index  Int
  attempts    Int      @default(1)
  lastScore   Int
  lastPassed  Boolean
  lastAnswers Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id, step_index], name: "user_id_lesson_id_step_index")
}

enum Roles {
  ADMIN
  USER
}
